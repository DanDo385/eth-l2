# eth-l2 - public env only (no secrets, no LAN IPs).
#
# Architecture:
#   Vercel frontend  →  same-origin /api/* + /health (rewrites)
#                    →  https://api-staging-eth-l2.magro.dev  (Cloudflare Tunnel)
#                    →  http://127.0.0.1:8080 on Ubuntu (Go + Anvil)
#
# Local `make dev`: leave NEXT_PUBLIC_* unset (or omit this file) so the browser
# talks to 127.0.0.1:8080. Do not `vercel env pull` for local labs - those values
# are for the hosted Vercel UI + Cloudflare Tunnel split.
#
# In development, app/data/ports.ts ignores same-origin/tunnel unless you set
# ETH_L2_ENABLE_API_PROXY=1 (matches next.config.ts rewrite gate).

# Server-only origin used by Next.js rewrites on Vercel (and ETH_L2_ENABLE_API_PROXY=1).
# ETH_L2_BACKEND_ORIGIN=https://api-staging-eth-l2.magro.dev

# Browser REST base. Empty / "same-origin" = call the Vercel deployment itself
# (rewrites proxy to ETH_L2_BACKEND_ORIGIN). Do not put LAN IPs here.
# NEXT_PUBLIC_API_URL=same-origin

# WebSocket must hit the tunnel directly (Vercel does not proxy WS upgrades).
# NEXT_PUBLIC_WS_URL=wss://api-staging-eth-l2.magro.dev/stream

# Optional: lock Go CORS to your Vercel origin(s), comma-separated.
# Staging scripts default this from config/ports.json → staging.vercelOrigin.
# ETH_L2_ALLOWED_ORIGINS=https://eth-l2.vercel.app

# Optional: API bearer token for POST /api/* and WebSocket /stream (backend only).
# Leave unset for the public Vercel + Ubuntu demo (browser cannot safely hold a secret).
# For private deployments, inject via secret manager / host env - never commit, never put in frontend JS.
# See backend/README.md for curl + WebSocket subprotocol usage.
# ETH_L2_API_TOKEN=

# Optional: trust X-Forwarded-For for rate-limit client IP (only behind a known proxy).
# ETH_L2_TRUST_X_FORWARDED_FOR=1

# Optional: stop the demo session after the last lab WebSocket client disconnects.
# Default 45. Set 0 to disable (session runs until Stop or process exit).
# ETH_L2_IDLE_STOP_SECONDS=45

# Optional: canonical public site URL for Agent Mode (/agent.json, /llms.txt).
# Defaults to https://eth-l2.vercel.app when unset.
# NEXT_PUBLIC_SITE_URL=https://eth-l2.vercel.app
