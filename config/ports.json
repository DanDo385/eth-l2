{
  "project": "eth-l2",
  "description": "Canonical ports for this repo. Scripts, Makefile, Cloudflare Tunnel ingress, and local Next rewrites should match these values. Backend uses 8080 so eth-tx-lifecycle can keep 8081.",
  "frontend": {
    "host": "127.0.0.1",
    "port": 3001,
    "url": "http://127.0.0.1:3001"
  },
  "backend": {
    "host": "127.0.0.1",
    "port": 8080,
    "url": "http://127.0.0.1:8080",
    "bind": "127.0.0.1:8080",
    "wsPath": "/stream"
  },
  "anvil": {
    "l1": {
      "port": 8545,
      "chainId": 31337,
      "rpc": "http://127.0.0.1:8545"
    },
    "opL2": {
      "port": 9545,
      "chainId": 31338,
      "rpc": "http://127.0.0.1:9545"
    },
    "zkL2": {
      "port": 10545,
      "chainId": 31339,
      "rpc": "http://127.0.0.1:10545"
    }
  },
  "staging": {
    "publicApiOrigin": "https://api-staging-eth-l2.magro.dev",
    "vercelOrigin": "https://eth-l2.vercel.app",
    "tunnelService": "http://127.0.0.1:8080"
  }
}
